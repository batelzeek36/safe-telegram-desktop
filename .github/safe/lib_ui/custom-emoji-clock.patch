--- /dev/null
+++ b/ui/text/custom_emoji_clock.h
@@ -0,0 +1,25 @@
+// This file is part of Desktop App Toolkit,
+// a set of libraries for developing nice desktop applications.
+//
+// For license and copyright information please follow this link:
+// https://github.com/desktop-app/legal/blob/master/LEGAL
+//
+#pragma once
+
+#include <cstdint>
+
+namespace Ui::CustomEmoji {
+
+// WHY: a repaint asked for at the due time lands on the next screen refresh,
+// so counting each frame from its paint played emoji at two thirds speed;
+// the clock restarts at the paint only after a hitch as long as a frame.
+[[nodiscard]] inline std::int64_t FrameStarted(
+		std::int64_t finished,
+		std::int64_t now,
+		std::int64_t nextDuration) {
+	return (nextDuration > 0 && now - finished < nextDuration)
+		? finished
+		: now;
+}
+
+} // namespace Ui::CustomEmoji
