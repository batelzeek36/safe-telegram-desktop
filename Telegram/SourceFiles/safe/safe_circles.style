using "ui/basic.style";

// The chat circles' type, from the mocks' column sizes
// (docs/previews/circles: .cv-column .hub-*, .pc-*).
circlesHubName: TextStyle(defaultTextStyle) {
	font: font(13px semibold);
}
circlesHubText: TextStyle(defaultTextStyle) {
	font: font(12px);
}
circlesHubTimeFont: font(11px);
circlesCardName: TextStyle(defaultTextStyle) {
	font: font(14px semibold);
}
circlesCardText: TextStyle(defaultTextStyle) {
	font: font(13px);
}
circlesCardTimeFont: font(12px);
circlesHintFont: font(11px);
